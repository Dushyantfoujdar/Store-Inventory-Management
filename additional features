<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Store Inventory Dashboard</title>

<!-- LIBRARIES -->

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="https://unpkg.com/html5-qrcode"></script>

<script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Segoe UI',sans-serif;
}

body{

background:
linear-gradient(
135deg,
#0f172a,
#1e293b,
#1d4ed8,
#0f766e
);

color:white;

min-height:100vh;

}

.app{
padding:20px;
}

h1{
font-size:34px;
margin-bottom:10px;
}

.topButtons{

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(220px,1fr));

gap:15px;

margin-top:25px;

}

.topButtons button{

padding:18px;

border:none;

border-radius:20px;

font-size:16px;

font-weight:bold;

cursor:pointer;

color:white;

transition:0.3s;

box-shadow:
0 10px 25px rgba(0,0,0,0.3);

}

.topButtons button:hover{
transform:translateY(-4px);
}

.issue{
background:linear-gradient(to right,#ef4444,#dc2626);
}

.receive{
background:linear-gradient(to right,#22c55e,#15803d);
}

.scan{
background:linear-gradient(to right,#2563eb,#1d4ed8);
}

.report{
background:linear-gradient(to right,#f59e0b,#d97706);
}

.materialBtn{
background:linear-gradient(to right,#7c3aed,#5b21b6);
}

.cards{

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(220px,1fr));

gap:20px;

margin-top:30px;

}

.card{

padding:25px;

border-radius:25px;

background:
rgba(255,255,255,0.08);

backdrop-filter:blur(12px);

cursor:pointer;

transition:0.3s;

box-shadow:
0 10px 30px rgba(0,0,0,0.3);

}

.card:hover{
transform:translateY(-5px);
}

.card p{

font-size:38px;
font-weight:bold;
margin-top:15px;

}

.searchBox{

width:100%;

padding:15px;

margin-top:18px;

border:none;

border-radius:15px;

background:
rgba(255,255,255,0.08);

color:white;

outline:none;

font-size:15px;

}

.searchBox::placeholder{
color:#ddd;
}

select{
background:#0f172a !important;
color:white !important;
}

option{
background:#0f172a;
color:white;
}

.tableContainer{

overflow-x:auto;

margin-top:25px;

border-radius:20px;

}

table{

width:100%;
border-collapse:collapse;
text-align:center;

}

th{

padding:16px;

background:
linear-gradient(
to right,
#2563eb,
#06b6d4
);

}

td{

padding:15px;

border-bottom:
1px solid rgba(255,255,255,0.1);

}

tr:hover{
background:rgba(255,255,255,0.05);
}

.low{
color:#ff4d6d;
font-weight:bold;
}

.normal{
color:#4ade80;
font-weight:bold;
}

.panelButton{

margin-top:20px;

padding:15px;

width:100%;

border:none;

border-radius:15px;

font-size:16px;

font-weight:bold;

cursor:pointer;

background:
linear-gradient(
to right,
#2563eb,
#06b6d4
);

color:white;

}

.transaction{

padding:15px;

margin-top:15px;

border-radius:15px;

background:
rgba(255,255,255,0.08);

}

.editBtn{

padding:8px 14px;

border:none;

border-radius:10px;

background:#2563eb;

color:white;

cursor:pointer;

}

.editBtn:hover{
background:#1d4ed8;
}

.popupOverlay{

position:fixed;

top:0;
left:0;

width:100%;
height:100%;

background:
rgba(0,0,0,0.7);

display:none;

align-items:center;
justify-content:center;

z-index:9999;

padding:20px;

overflow:auto;

}

.popupBox{

width:100%;
max-width:600px;

background:
linear-gradient(
135deg,
#0f172a,
#1e293b,
#1d4ed8,
#0f766e
);

padding:25px;

border-radius:25px;

box-shadow:
0 10px 40px rgba(0,0,0,0.5);

animation:popup 0.3s ease;

}

@keyframes popup{

from{
transform:scale(0.8);
opacity:0;
}

to{
transform:scale(1);
opacity:1;
}

}

.popupTop{

display:flex;

justify-content:space-between;

align-items:center;

margin-bottom:20px;

}

.closePopup{

background:red;

border:none;

color:white;

padding:10px 15px;

border-radius:10px;

cursor:pointer;

font-weight:bold;

}

#qrcode{

background:white;

padding:20px;

border-radius:20px;

margin-top:20px;

display:flex;

flex-direction:column;

align-items:center;

justify-content:center;

min-height:280px;

color:black;

}

#reader{
margin-top:20px;
}

@media(max-width:768px){

.topButtons{
grid-template-columns:1fr;
}

}

</style>

</head>

<body>

<div class="app">

<h1>📦 Store Inventory Dashboard</h1>

<p> QR Based Store Inventory Management System</p>

<!-- TOP BUTTONS -->

<div class="topButtons">

<button
class="issue"
onclick="openTransactionPopup()"
>
Issue / Receive
</button>

<button
class="receive"
onclick="openQRPopup()"
>
Generate QR
</button>

<button
class="scan"
onclick="openScannerPopup()"
>
Scan QR
</button>

<button
class="report"
onclick="openReportPopup()"
>
Reports
</button>

<button
class="materialBtn"
onclick="
clearMaterialForm();
openMaterialPopup();
"
>
Add Material
</button>

</div>

<!-- CARDS -->

<div class="cards">

<div
class="card"
onclick="scrollToInventory()"
>

<h3>Total Materials</h3>

<p id="totalMaterials"></p>

</div>

<div
class="card"
onclick="showLowStock()"
>

<h3>Low Stock</h3>

<p id="lowStock"></p>

</div>

<div
class="card"
onclick="showTodayTransactionsPopup()"
>

<h3>Today's Transactions</h3>

<p id="todayTransactions"></p>

</div>

</div>

<!-- INVENTORY -->

<div id="inventorySection">

<div class="tableContainer">

<table>

<thead>

<tr>

<th>Code</th>
<th>Name</th>
<th>Category</th>
<th>Unit</th>
<th>Stock</th>
<th>Reorder</th>
<th>Status</th>
<th>Edit</th>

</tr>

</thead>

<tbody id="inventoryTable"></tbody>

</table>

</div>

</div>

</div>

<!-- ISSUE RECEIVE POPUP -->

<div
id="transactionPopup"
class="popupOverlay"
>

<div class="popupBox">

<div class="popupTop">

<h2>Issue / Receive Material</h2>

<button
class="closePopup"
onclick="closePopup('transactionPopup')"
>
X
</button>

</div>

<select
id="actionSelect"
class="searchBox"
>

<option value="issue">
Issue Material
</option>

<option value="receive">
Receive Material
</option>

</select>

<select
id="materialSelect"
class="searchBox"
></select>

<input
type="number"
id="qtyInput"
class="searchBox"
placeholder="Enter Quantity"
>

<input
type="text"
id="personInput"
class="searchBox"
placeholder="Issued To / Received From"
>

<button
class="panelButton"
onclick="submitTransaction()"
>
Submit Transaction
</button>

</div>

</div>

<!-- QR POPUP -->

<div
id="qrPopup"
class="popupOverlay"
>

<div class="popupBox">

<div class="popupTop">

<h2>Generate QR</h2>

<button
class="closePopup"
onclick="closePopup('qrPopup')"
>
X
</button>

</div>

<select
id="qrMaterial"
class="searchBox"
></select>

<button
class="panelButton"
onclick="generateQRLabel()"
>
Generate QR
</button>

<button
class="panelButton"
onclick="downloadQR()"
>
Download QR
</button>

<div id="qrcode"></div>

</div>

</div>

<!-- SCANNER POPUP -->

<div
id="scannerPopup"
class="popupOverlay"
>

<div class="popupBox">

<div class="popupTop">

<h2>QR Scanner</h2>

<button
class="closePopup"
onclick="closePopup('scannerPopup')"
>
X
</button>

</div>

<div id="reader"></div>

</div>

</div>

<!-- REPORT POPUP -->

<div
id="reportPopup"
class="popupOverlay"
>

<div class="popupBox">

<div class="popupTop">

<h2>Material Transaction Report</h2>

<button
class="closePopup"
onclick="closePopup('reportPopup')"
>
X
</button>

</div>

<select
id="reportMaterial"
class="searchBox"
></select>

<input
type="date"
id="fromDate"
class="searchBox"
>

<input
type="date"
id="toDate"
class="searchBox"
>

<button
class="panelButton"
onclick="generateReport()"
>
Generate Report
</button>

<div
id="downloadButtons"
style="display:none;"
>

<button
class="panelButton"
onclick="downloadExcel()"
>
Download Excel
</button>

<button
class="panelButton"
onclick="downloadPDF()"
>
Download PDF
</button>

</div>

<div id="historyContainer"></div>

</div>

</div>

<!-- ADD MATERIAL POPUP -->

<div
id="materialPopup"
class="popupOverlay"
>

<div class="popupBox">

<div class="popupTop">

<h2>Add Material</h2>

<button
class="closePopup"
onclick="closePopup('materialPopup')"
>
X
</button>

</div>

<input
type="text"
id="matCode"
class="searchBox"
placeholder="Material Code"
>

<input
type="text"
id="matName"
class="searchBox"
placeholder="Material Name"
>

<input
type="text"
id="matCategory"
class="searchBox"
placeholder="Category"
>

<input
type="text"
id="matUnit"
class="searchBox"
placeholder="Unit"
>

<input
type="number"
id="matStock"
class="searchBox"
placeholder="Current Stock"
>

<input
type="number"
id="matReorder"
class="searchBox"
placeholder="Reorder Value"
>

<button
class="panelButton"
onclick="saveMaterial()"
>
Save Material
</button>

</div>

</div>

<!-- EDIT POPUP -->

<div
id="editPopup"
class="popupOverlay"
>

<div class="popupBox">

<div class="popupTop">

<h2>Edit Material</h2>

<button
class="closePopup"
onclick="closePopup('editPopup')"
>
X
</button>

</div>

<input
type="text"
id="editCode"
class="searchBox"
placeholder="Material Code"
>

<input
type="text"
id="editName"
class="searchBox"
placeholder="Material Name"
>

<input
type="text"
id="editCategory"
class="searchBox"
placeholder="Category"
>

<input
type="text"
id="editUnit"
class="searchBox"
placeholder="Unit"
>

<input
type="number"
id="editStock"
class="searchBox"
placeholder="Current Stock"
>

<input
type="number"
id="editReorder"
class="searchBox"
placeholder="Reorder Value"
>

<button
class="panelButton"
onclick="updateMaterial()"
>
Update Material
</button>

</div>

</div>

<!-- TODAY POPUP -->

<div
id="todayPopup"
class="popupOverlay"
>

<div class="popupBox">

<div class="popupTop">

<h2>Today's Transactions</h2>

<button
class="closePopup"
onclick="closePopup('todayPopup')"
>
X
</button>

</div>

<div id="todayTransactionList"></div>

</div>

</div>

<script>

let materials=[

{
code:'0838181493',
name:'TES',
category:'Valves',
unit:'Nos.',
stock:95,
reorder:20
},

{
code:'0838880104',
name:'SC Valve New',
category:'Valves',
unit:'Nos.',
stock:100,
reorder:20
},

{
code:'0838881066',
name:'Combo Valve',
category:'Valves',
unit:'Nos.',
stock:75,
reorder:20
},

{
code:'0838882104',
name:'LOT Valve',
category:'Valves',
unit:'Nos.',
stock:60,
reorder:20
},

{
code:'0838911014',
name:'Pressure Regulator',
category:'Safety',
unit:'Nos.',
stock:40,
reorder:15
},

{
code:'0838920104',
name:'Safety Caps',
category:'Safety',
unit:'Nos.',
stock:250,
reorder:50
},

{
code:'0838929014',
name:'Nylon Thread',
category:'Consumables',
unit:'Nos.',
stock:150,
reorder:30
},

{
code:'0838929034',
name:'SS Clip',
category:'Consumables',
unit:'Nos.',
stock:80,
reorder:20
},

{
code:'0838930764',
name:'NBR O-Ring',
category:'Consumables',
unit:'Nos.',
stock:120,
reorder:25
},

{
code:'0838930774',
name:'FKM O-Ring',
category:'Consumables',
unit:'Nos.',
stock:90,
reorder:25
}

];

let transactionHistory=
JSON.parse(
localStorage.getItem('transactions')
)||[];

const savedMaterials=
JSON.parse(
localStorage.getItem('materials')
);

if(savedMaterials){
materials=savedMaterials;
}

let currentEditIndex=null;

function saveData(){

localStorage.setItem(
'transactions',
JSON.stringify(transactionHistory)
);

localStorage.setItem(
'materials',
JSON.stringify(materials)
);

}

function renderTable(){

const table=
document.getElementById(
'inventoryTable'
);

table.innerHTML='';

let low=0;

materials.forEach((item,index)=>{

if(item.stock<=item.reorder){
low++;
}

table.innerHTML += 

<tr>

<td>${item.code}</td>
<td>${item.name}</td>
<td>${item.category}</td>
<td>${item.unit}</td>
<td>${item.stock}</td>
<td>${item.reorder}</td>

<td class="${
item.stock<=item.reorder
?'low'
:'normal'
}">
${
item.stock<=item.reorder
?'Low'
:'Normal'
}
</td>

<td style="text-align:center;">

<button
class="editBtn"
onclick="editMaterial(${index})"
>
Edit
</button>

</td>

</tr>

;

});

document.getElementById(
'totalMaterials'
).innerHTML=
materials.length;

document.getElementById(
'lowStock'
).innerHTML=
low;

const today=
new Date().toDateString();

const todayCount=
transactionHistory.filter(t=>{

return new Date(t.date)
.toDateString()===today;

}).length;

document.getElementById(
'todayTransactions'
).innerHTML=
todayCount;

fillDropdowns();

saveData();

}

function fillDropdowns(){

const ids=[
'materialSelect',
'qrMaterial',
'reportMaterial'
];

ids.forEach(id=>{

const dropdown=
document.getElementById(id);

dropdown.innerHTML='';

materials.forEach(item=>{

dropdown.innerHTML += 

<option value="${item.code}">
${item.code} - ${item.name}
</option>

;

});

});

}

function openTransactionPopup(){

document.getElementById(
'transactionPopup'
).style.display='flex';

}

function openQRPopup(){

document.getElementById(
'qrPopup'
).style.display='flex';

}

function openScannerPopup(){

document.getElementById(
'scannerPopup'
).style.display='flex';

startScanner();

}

function openReportPopup(){

document.getElementById(
'reportPopup'
).style.display='flex';

}

function openMaterialPopup(){

document.getElementById(
'materialPopup'
).style.display='flex';

}

function closePopup(id){

document.getElementById(id)
.style.display='none';

}

function clearMaterialForm(){

document.getElementById(
'matCode'
).value='';

document.getElementById(
'matName'
).value='';

document.getElementById(
'matCategory'
).value='';

document.getElementById(
'matUnit'
).value='';

document.getElementById(
'matStock'
).value='';

document.getElementById(
'matReorder'
).value='';

}

function saveMaterial(){

const code=
document.getElementById(
'matCode'
).value;

const name=
document.getElementById(
'matName'
).value;

const category=
document.getElementById(
'matCategory'
).value;

const unit=
document.getElementById(
'matUnit'
).value;

const stock=
parseInt(
document.getElementById(
'matStock'
).value
);

const reorder=
parseInt(
document.getElementById(
'matReorder'
).value
);

if(
!code ||
!name ||
!category ||
!unit ||
isNaN(stock) ||
isNaN(reorder)
){

Swal.fire(
'Error',
'Fill all fields',
'error'
);

return;

}

materials.push({

code,
name,
category,
unit,
stock,
reorder

});

renderTable();

clearMaterialForm();

closePopup(
'materialPopup'
);

Swal.fire(
'Success',
'Material Added',
'success'
);

}

function editMaterial(index){

currentEditIndex=index;

const item=
materials[index];

document.getElementById(
'editPopup'
).style.display='flex';

document.getElementById(
'editCode'
).value=
item.code;

document.getElementById(
'editName'
).value=
item.name;

document.getElementById(
'editCategory'
).value=
item.category;

document.getElementById(
'editUnit'
).value=
item.unit;

document.getElementById(
'editStock'
).value=
item.stock;

document.getElementById(
'editReorder'
).value=
item.reorder;

}

function updateMaterial(){

const item=
materials[currentEditIndex];

item.code=
document.getElementById(
'editCode'
).value;

item.name=
document.getElementById(
'editName'
).value;

item.category=
document.getElementById(
'editCategory'
).value;

item.unit=
document.getElementById(
'editUnit'
).value;

item.stock=
parseInt(
document.getElementById(
'editStock'
).value
);

item.reorder=
parseInt(
document.getElementById(
'editReorder'
).value
);

saveData();

renderTable();

closePopup(
'editPopup'
);

Swal.fire(
'Updated',
'Material Updated Successfully',
'success'
);

}

function submitTransaction(){

const action=
document.getElementById(
'actionSelect'
).value;

const code=
document.getElementById(
'materialSelect'
).value;

const qty=
parseInt(
document.getElementById(
'qtyInput'
).value
);

const person=
document.getElementById(
'personInput'
).value;

const material=
materials.find(
m => m.code===code
);

if(!qty || !person){

Swal.fire(
'Error',
'Fill all details',
'error'
);

return;

}

if(action==='issue'){

if(qty>material.stock){

Swal.fire(
'Error',
'Insufficient Stock',
'error'
);

return;

}

material.stock -= qty;

}
else{

material.stock += qty;

}

transactionHistory.unshift({

material:material.name,
materialCode:material.code,
action:action,
qty:qty,
person:person,
balance:material.stock,
date:new Date().toISOString()

});

renderTable();

closePopup(
'transactionPopup'
);

Swal.fire(
'Success',
'Transaction Successful',
'success'
);

}

function generateQRLabel(){

const code=
document.getElementById(
'qrMaterial'
).value;

const material=
materials.find(
m => m.code===code
);

const qrDiv=
document.getElementById(
'qrcode'
);

qrDiv.innerHTML='';

const canvas=
document.createElement(
'canvas'
);

qrDiv.appendChild(canvas);

QRCode.toCanvas(

canvas,

JSON.stringify({

code:material.code,
name:material.name

}),

{
width:220
},

function(error){

if(error){

Swal.fire(
'Error',
'QR Generation Failed',
'error'
);

return;

}

const label=
document.createElement('div');

label.innerHTML=

<h3>${material.name}</h3>
<p>${material.code}</p>

;

qrDiv.appendChild(label);

}

);

}

function downloadQR(){

html2canvas(
document.getElementById(
'qrcode'
)

).then(canvas=>{

const link=
document.createElement('a');

link.download='QR.png';

link.href=
canvas.toDataURL();

link.click();

});

}

function startScanner(){

document.getElementById(
'reader'
).innerHTML='';

const html5QrCode=
new Html5Qrcode('reader');

html5QrCode.start(

{ facingMode:'environment' },

{
fps:10,
qrbox:250
},

(decodedText)=>{

try{

const qrData=
JSON.parse(decodedText);

const material=
materials.find(
m => m.code===qrData.code
);

if(material){

html5QrCode.stop();

closePopup(
'scannerPopup'
);

openTransactionPopup();

document.getElementById(
'materialSelect'
).value=
material.code;

Swal.fire(
'QR Scanned',
material.name,
'success'
);

}

}
catch(err){

Swal.fire(
'Error',
'Invalid QR',
'error'
);

}

}

);

}

function generateReport(){

const materialCode=
document.getElementById(
'reportMaterial'
).value;

const from=
document.getElementById(
'fromDate'
).value;

const to=
document.getElementById(
'toDate'
).value;

const container=
document.getElementById(
'historyContainer'
);

container.innerHTML='';

const filtered=
transactionHistory.filter(t=>{

const tDate=
new Date(t.date);

const fromDate=
new Date(from);

const toDate=
new Date(to);

toDate.setHours(23,59,59,999);

return (

t.materialCode===materialCode &&

tDate>=fromDate &&

tDate<=toDate

);

});

window.filteredTransactions=
filtered;

if(filtered.length===0){

container.innerHTML=
<div class="transaction">
No Transactions Found
</div>
;

document.getElementById(
'downloadButtons'
).style.display='none';

return;

}

document.getElementById(
'downloadButtons'
).style.display='block';

filtered.forEach(item=>{

container.innerHTML += 

<div class="transaction">

<b>${item.material}</b>

<br><br>

Action:
${item.action}

<br>

Quantity:
${item.qty}

<br>

Issued To / Received From:
${item.person}

<br>

Balance:
${item.balance}

<br>

Date:
${new Date(item.date)
.toLocaleString()}

</div>

;

});

