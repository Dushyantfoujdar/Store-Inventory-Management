<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Professional Smart Inventory Dashboard</title>

<!-- LIBRARIES -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="https://unpkg.com/html5-qrcode"></script>

<script src="https://cdn.jsdelivr.net/npm/qrcode/build/qrcode.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Segoe UI',sans-serif;
}

body{

background:
linear-gradient(
135deg,
#0f172a,
#1e3a8a,
#0f766e
);

color:white;
min-height:100vh;
display:flex;

}

.sidebar{

width:260px;

background:
rgba(0,0,0,0.3);

backdrop-filter:blur(10px);

padding:25px;

position:fixed;

height:100vh;

overflow:auto;

}

.logo{

font-size:28px;
font-weight:bold;
margin-bottom:40px;

}

.menu button{

width:100%;

padding:15px;

margin-bottom:15px;

border:none;

border-radius:15px;

background:
rgba(255,255,255,0.08);

color:white;

font-size:15px;

cursor:pointer;

transition:0.3s;

}

.menu button:hover{

background:
linear-gradient(
to right,
#2563eb,
#06b6d4
);

}

.main{

margin-left:280px;

padding:25px;

width:100%;

}

.topBar{

display:flex;

justify-content:space-between;

align-items:center;

flex-wrap:wrap;

gap:15px;

}

.toggleBtn{

padding:12px 20px;

border:none;

border-radius:15px;

background:
linear-gradient(
to right,
#7c3aed,
#2563eb
);

color:white;

cursor:pointer;

font-weight:bold;

}

.cards{

display:grid;

grid-template-columns:
repeat(auto-fit,minmax(220px,1fr));

gap:20px;

margin-top:30px;

}

.card{

padding:25px;

border-radius:25px;

background:
rgba(255,255,255,0.08);

backdrop-filter:blur(12px);

box-shadow:
0 10px 25px rgba(0,0,0,0.3);

transition:0.3s;

cursor:pointer;

}

.card:hover{

transform:translateY(-5px);

}

.card h3{
font-size:18px;
}

.card p{

font-size:38px;
font-weight:bold;
margin-top:15px;

}

.section{

margin-top:35px;

padding:25px;

border-radius:25px;

background:
rgba(255,255,255,0.08);

backdrop-filter:blur(12px);

}

.searchBox{

width:100%;

padding:15px;

margin-top:20px;

border:none;

border-radius:15px;

background:
rgba(255,255,255,0.08);

color:white;

outline:none;

}

.searchBox::placeholder{
color:#ddd;
}

select{

background:#0f172a !important;
color:white !important;

}

option{

background:#0f172a;
color:white;

}

.tableContainer{

overflow-x:auto;
margin-top:20px;

}

table{

width:100%;
border-collapse:collapse;

}

th{

padding:15px;

background:
linear-gradient(
to right,
#2563eb,
#06b6d4
);

}

td{

padding:14px;

border-bottom:
1px solid rgba(255,255,255,0.1);

}

tr:hover{
background:rgba(255,255,255,0.05);
}

.low{
color:#ff4d6d;
font-weight:bold;
}

.normal{
color:#4ade80;
font-weight:bold;
}

.buttons{

display:flex;
gap:15px;
flex-wrap:wrap;
margin-top:25px;

}

button{

padding:14px 18px;

border:none;

border-radius:15px;

font-weight:bold;

cursor:pointer;

color:white;

transition:0.3s;

}

button:hover{

transform:translateY(-3px);

}

.issue{
background:linear-gradient(to right,#ef4444,#dc2626);
}

.receive{
background:linear-gradient(to right,#22c55e,#15803d);
}

.scan{
background:linear-gradient(to right,#3b82f6,#1d4ed8);
}

.download{
background:linear-gradient(to right,#f59e0b,#d97706);
}

.panel{

display:none;

margin-top:25px;

padding:25px;

border-radius:25px;

background:
rgba(255,255,255,0.08);

}

.transaction{

padding:15px;

margin-top:15px;

border-radius:15px;

background:
rgba(255,255,255,0.08);

}

#qrcode{

background:white;

padding:25px;

border-radius:20px;

margin-top:20px;

display:flex;

flex-direction:column;

align-items:center;

justify-content:center;

color:black;

}

.chartContainer{

margin-top:25px;

height:350px;

}

.lightMode{

background:#f1f5f9;
color:black;

}

.lightMode .sidebar{
background:white;
}

.lightMode .section,
.lightMode .card{
background:white;
color:black;
}

.lightMode table{
color:black;
}

.lightMode .searchBox{
background:#e2e8f0;
color:black;
}

@media(max-width:900px){

.sidebar{
position:relative;
width:100%;
height:auto;
}

.main{
margin-left:0;
}

body{
flex-direction:column;
}

}

</style>

</head>

<body>

<!-- SIDEBAR -->

<div class="sidebar">

<div class="logo">
📦 Inventory ERP
</div>

<div class="menu">

<button onclick="scrollToSection('dashboard')">
Dashboard
</button>

<button onclick="scrollToSection('inventory')">
Inventory
</button>

<button onclick="scrollToSection('transactionPanel')">
Issue / Receive
</button>

<button onclick="scrollToSection('qrPanel')">
QR Generator
</button>

<button onclick="scrollToSection('historyPanel')">
Reports
</button>

</div>

</div>

<!-- MAIN -->

<div class="main">

<div class="topBar">

<div>

<h1>Professional Inventory Dashboard</h1>

<p>Enterprise QR Based Inventory Management System</p>

</div>

<button
class="toggleBtn"
onclick="toggleMode()"
>
🌙 Dark / Light
</button>

</div>

<!-- KPI CARDS -->

<div class="cards" id="dashboard">

<div class="card">
<h3>Total Materials</h3>
<p id="totalMaterials"></p>
</div>

<div class="card" onclick="showLowStock()">
<h3>Low Stock</h3>
<p id="lowStock"></p>
</div>

<div class="card">
<h3>Transactions Today</h3>
<p id="todayTransactions">0</p>
</div>

<div class="card">
<h3>Total Inventory</h3>
<p id="totalStock">0</p>
</div>

</div>

<!-- CHART -->

<div class="section">

<h2>Inventory Analytics</h2>

<div class="chartContainer">
<canvas id="stockChart"></canvas>
</div>

</div>

<!-- INVENTORY -->

<div class="section" id="inventory">

<h2>Inventory Table</h2>

<input
type="text"
class="searchBox"
placeholder="Search Material"
onkeyup="searchMaterial(this.value)"
>

<div class="tableContainer">

<table>

<thead>

<tr>
<th>Code</th>
<th>Name</th>
<th>Category</th>
<th>Unit</th>
<th>Stock</th>
<th>Reorder</th>
<th>Status</th>
</tr>

</thead>

<tbody id="inventoryTable"></tbody>

</table>

</div>

</div>

<!-- BUTTONS -->

<div class="buttons">

<button class="issue" onclick="openPanel()">
Issue / Receive
</button>

<button class="scan" onclick="startScanner()">
Scan QR
</button>

<button class="receive" onclick="openQRPanel()">
Generate QR
</button>

<button class="download" onclick="openHistoryPanel()">
Reports
</button>

</div>

<!-- ISSUE RECEIVE -->

<div id="transactionPanel" class="panel section">

<h2>Material Transaction</h2>

<select id="actionSelect" class="searchBox">

<option value="issue">
Issue Material
</option>

<option value="receive">
Receive Material
</option>

</select>

<select id="materialSelect" class="searchBox"></select>

<input
type="number"
id="qtyInput"
class="searchBox"
placeholder="Quantity"
>

<input
type="text"
id="personInput"
class="searchBox"
placeholder="Issued To / Received From"
>

<button
class="scan"
style="margin-top:20px;"
onclick="submitTransaction()"
>
Submit Transaction
</button>

</div>

<!-- QR PANEL -->

<div id="qrPanel" class="panel section">

<h2>QR Generator</h2>

<select id="qrMaterial" class="searchBox"></select>

<button
class="scan"
style="margin-top:20px;"
onclick="generateQRLabel()"
>
Generate QR
</button>

<button
class="download"
style="margin-top:20px;"
onclick="downloadQR()"
>
Download QR PNG
</button>

<div id="qrcode"></div>

</div>

<!-- QR READER -->

<div id="reader"></div>

<!-- REPORTS -->

<div id="historyPanel" class="panel section">

<h2>Material Transaction Reports</h2>

<select id="reportMaterial" class="searchBox"></select>

<input
type="date"
id="fromDate"
class="searchBox"
>

<input
type="date"
id="toDate"
class="searchBox"
>

<div class="buttons">

<button class="scan" onclick="generateHistory()">
Generate Report
</button>

<button class="download" onclick="downloadExcel()">
Download Excel
</button>

<button class="download" onclick="downloadPDF()">
Download PDF
</button>

</div>

<div id="historyContainer"></div>

</div>

</div>

<script>

let materials=[

{
code:'0838181493',
name:'TES',
category:'Valves',
unit:'Nos.',
stock:95,
reorder:20
},

{
code:'0838880104',
name:'SC Valve New',
category:'Valves',
unit:'Nos.',
stock:100,
reorder:20
},

{
code:'0838881066',
name:'Combo Valve',
category:'Valves',
unit:'Nos.',
stock:75,
reorder:20
},

{
code:'0838882104',
name:'LOT Valve',
category:'Valves',
unit:'Nos.',
stock:60,
reorder:20
},

{
code:'0838911014',
name:'Pressure Regulator',
category:'Safety',
unit:'Nos.',
stock:40,
reorder:15
},

{
code:'0838920104',
name:'Safety Caps',
category:'Safety',
unit:'Nos.',
stock:250,
reorder:50
},

{
code:'0838929014',
name:'Nylon Thread',
category:'Consumables',
unit:'Nos.',
stock:150,
reorder:30
},

{
code:'0838929034',
name:'SS Clip',
category:'Consumables',
unit:'Nos.',
stock:80,
reorder:20
},

{
code:'0838930764',
name:'NBR O-Ring',
category:'Consumables',
unit:'Nos.',
stock:120,
reorder:25
},

{
code:'0838930774',
name:'FKM O-Ring',
category:'Consumables',
unit:'Nos.',
stock:90,
reorder:25
}

];

let transactionHistory=
JSON.parse(
localStorage.getItem('transactions')
)||[];

function saveData(){

localStorage.setItem(
'transactions',
JSON.stringify(transactionHistory)
);

localStorage.setItem(
'materials',
JSON.stringify(materials)
);

}

const savedMaterials=
JSON.parse(
localStorage.getItem('materials')
);

if(savedMaterials){
materials=savedMaterials;
}

function renderTable(){

const table=
document.getElementById(
'inventoryTable'
);

table.innerHTML='';

let low=0;
let total=0;

materials.forEach(item=>{

total += item.stock;

if(item.stock<=item.reorder){
low++;
}

table.innerHTML += `

<tr>

<td>${item.code}</td>

<td>${item.name}</td>

<td>${item.category}</td>

<td>${item.unit}</td>

<td>${item.stock}</td>

<td>${item.reorder}</td>

<td class="${
item.stock<=item.reorder?'low':'normal'
}">

${
item.stock<=item.reorder?'Low':'Normal'
}

</td>

</tr>

`;

});

document.getElementById(
'totalMaterials'
).innerHTML=
materials.length;

document.getElementById(
'lowStock'
).innerHTML=
low;

document.getElementById(
'totalStock'
).innerHTML=
total;

document.getElementById(
'todayTransactions'
).innerHTML=
transactionHistory.length;

fillDropdowns();

renderChart();

}

function fillDropdowns(){

const dropdowns=[
'materialSelect',
'qrMaterial',
'reportMaterial'
];

dropdowns.forEach(id=>{

const d=
document.getElementById(id);

d.innerHTML='';

materials.forEach(item=>{

d.innerHTML += `
<option value="${item.code}">
${item.code} - ${item.name}
</option>
`;

});

});

}

function renderChart(){

const ctx=
document.getElementById(
'stockChart'
);

let normal=0;
let low=0;

materials.forEach(item=>{

if(item.stock<=item.reorder){
low++;
}
else{
normal++;
}

});

new Chart(ctx,{

type:'doughnut',

data:{

labels:[
'Normal Stock',
'Low Stock'
],

datasets:[{

data:[
normal,
low
]

}]

}

});

}

function showLowStock(){

const lowMaterials=
materials.filter(
m => m.stock<=m.reorder
);

let text='';

lowMaterials.forEach(item=>{

text += `
${item.name}
 - Stock:
${item.stock}<br>
`;

});

Swal.fire({

title:'Low Stock Materials',

html:text ||

'No Low Stock',

icon:'warning'

});

}

function openPanel(){

hidePanels();

document.getElementById(
'transactionPanel'
).style.display='block';

}

function openQRPanel(){

hidePanels();

document.getElementById(
'qrPanel'
).style.display='block';

}

function openHistoryPanel(){

hidePanels();

document.getElementById(
'historyPanel'
).style.display='block';

}

function hidePanels(){

document.getElementById(
'transactionPanel'
).style.display='none';

document.getElementById(
'qrPanel'
).style.display='none';

document.getElementById(
'historyPanel'
).style.display='none';

}

function submitTransaction(){

const action=
document.getElementById(
'actionSelect'
).value;

const code=
document.getElementById(
'materialSelect'
).value;

const qty=
parseInt(
document.getElementById(
'qtyInput'
).value
);

const person=
document.getElementById(
'personInput'
).value;

const material=
materials.find(
m => m.code===code
);

if(!qty || !person){

Swal.fire(
'Error',
'Fill All Details',
'error'
);

return;

}

if(action==='issue'){

if(qty>material.stock){

Swal.fire(
'Error',
'Insufficient Stock',
'error'
);

return;

}

material.stock -= qty;

}

else{

material.stock += qty;

}

transactionHistory.unshift({

material:material.name,

action:action,

qty:qty,

person:person,

balance:material.stock,

date:new Date().toLocaleString()

});

saveData();

renderTable();

Swal.fire(
'Success',
'Transaction Completed',
'success'
);

if(material.stock<=material.reorder){

Swal.fire(
'Warning',
`${material.name} Low Stock`,
'warning'
);

}

}

function generateQRLabel(){

const code=
document.getElementById(
'qrMaterial'
).value;

const material=
materials.find(
m => m.code===code
);

const qrDiv=
document.getElementById(
'qrcode'
);

qrDiv.innerHTML='';

const canvas=
document.createElement(
'canvas'
);

qrDiv.appendChild(canvas);

const qrData=
JSON.stringify({

code:material.code,

name:material.name

});

QRCode.toCanvas(

canvas,

qrData,

{
width:220
},

function(error){

if(error){

Swal.fire(
'Error',
'QR Failed',
'error'
);

return;

}

const label=
document.createElement('div');

label.innerHTML=`

<h3>
${material.name}
</h3>

<p>
${material.code}
</p>

`;

qrDiv.appendChild(label);

}

);

}

function downloadQR(){

html2canvas(
document.getElementById(
'qrcode'
)

).then(canvas=>{

const link=
document.createElement('a');

link.download='QR.png';

link.href=
canvas.toDataURL();

link.click();

});

}

function startScanner(){

const html5QrCode=
new Html5Qrcode(
'reader'
);

html5QrCode.start(

{ facingMode:'environment' },

{
fps:10,
qrbox:250
},

(decodedText)=>{

const qrData=
JSON.parse(decodedText);

const material=
materials.find(
m => m.code===qrData.code
);

if(material){

html5QrCode.stop();

openPanel();

document.getElementById(
'materialSelect'
).value=
material.code;

Swal.fire(
'QR Scanned',
material.name,
'success'
);

}

}

);

}

function generateHistory(){

const code=
document.getElementById(
'reportMaterial'
).value;

const container=
document.getElementById(
'historyContainer'
);

container.innerHTML='';

const filtered=
transactionHistory.filter(
t => t.material.includes(code)
);

filtered.forEach(item=>{

container.innerHTML += `

<div class="transaction">

<b>${item.material}</b>

<br><br>

Action:
${item.action}

<br>

Quantity:
${item.qty}

<br>

Person:
${item.person}

<br>

Balance:
${item.balance}

<br>

Date:
${item.date}

</div>

`;

});

}

function downloadExcel(){

const ws=
XLSX.utils.json_to_sheet(
transactionHistory
);

const wb=
XLSX.utils.book_new();

XLSX.utils.book_append_sheet(
wb,
ws,
'Transactions'
);

XLSX.writeFile(
wb,
'Inventory_Report.xlsx'
);

}

function downloadPDF(){

const { jsPDF }=
window.jspdf;

const pdf=
new jsPDF();

pdf.text(
'Inventory Report',
20,
20
);

let y=40;

transactionHistory.forEach(item=>{

pdf.text(

`${item.material}
 ${item.action}
 Qty:${item.qty}`,

10,
y

);

y += 10;

});

pdf.save(
'Inventory_Report.pdf'
);

}

function searchMaterial(value){

value=
value.toLowerCase();

const rows=
document.querySelectorAll(
'#inventoryTable tr'
);

rows.forEach(row=>{

if(
row.innerText
.toLowerCase()
.includes(value)
){

row.style.display='';

}
else{

row.style.display='none';

}

});

}

function toggleMode(){

document.body.classList.toggle(
'lightMode'
);

}

function scrollToSection(id){

document.getElementById(id)
.scrollIntoView({
behavior:'smooth'
});

}

window.onload=function(){

renderTable();

};

</script>

</body>

</html>
